starter_gift_dialogue_lines = Array[String](["Ah, there you are!", "Your father has collected and cared for Pokemon from every region over the years.", "Before he left, Dadinho prepared a Pokemon especially for you and entrusted it to me. It has been waiting here as his surprise."])
