func _add_chat_message(
	text: String,
	use_bbcode: bool = false,
	category: String = CHAT_CATEGORY_SYSTEM
) -> void:
	var entry := message_entry_template.duplicate() as RichTextLabel
	message_list.add_child(entry)
	entry.set_meta("chat_category", category)
	entry.visible = _should_show_chat_category(category)
	entry.bbcode_enabled = true
	entry.clear()
	if use_bbcode:
		entry.append_text(text)
	elif category == CHAT_CATEGORY_SYSTEM_WARNING:
		entry.append_text(_format_system_warning_chat_message(text))
	else:
		entry.append_text(_format_system_chat_message(text))
	entry.fit_content = true
	entry.scroll_active = false
	entry.set_meta("chat_message_context", _chat_message_context({}, "SYSTEM", text, ""))
	_enable_chat_message_actions(entry, entry)
	_scroll_chat_to_bottom.call_deferred()


