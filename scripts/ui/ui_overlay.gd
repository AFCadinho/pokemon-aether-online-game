	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 12)
	margin.add_child(row)

	var area_name := str(location.get(
		"areaName",
		location.get("areaId", LocalizationManager.text("ui.pokedex.locations.unknown_area"))
	)).strip_edges()
