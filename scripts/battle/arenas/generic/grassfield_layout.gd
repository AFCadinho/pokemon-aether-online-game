static func data() -> Dictionary:
	return DATA

static func transform_from(v: Array) -> Transform3D:
	return Transform3D(Basis(Vector3(v[0], v[1], v[2]), Vector3(v[3], v[4], v[5]),
		Vector3(v[6], v[7], v[8])), Vector3(v[9], v[10], v[11]))

static func height_at(x: float, z: float) -> float:
	var gx := clampf(x + 100, 0, 199.99999)
	var gz := clampf(z + 120, 0, 199.99999)
	var ix := floori(gx)
	var iz := floori(gz)
	var dx := gx - ix
	var dz := gz - iz
	var at := iz * 201 + ix
	var h: Array = DATA.heights
	if dx + dz <= 1:
		return h[at] + dx * (h[at + 1] - h[at]) + dz * (h[at + 201] - h[at])
	return h[at + 202] + (1 - dx) * (h[at + 201] - h[at + 202]) + (1 - dz) * (h[at + 1] - h[at + 202])
