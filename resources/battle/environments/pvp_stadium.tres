[gd_resource type="Resource" script_class="BattleEnvironmentProfile" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/battle/battle_environment_profile.gd" id="1_profile"]
[ext_resource type="Texture2D" path="res://assets/background/battle/pvp_stadium_fallback.jpg" id="2_background"]
[ext_resource type="VideoStream" path="res://assets/video/battle/pvp_stadium.ogv" id="3_video"]
[ext_resource type="Texture2D" path="res://assets/background/platform/pvp_stadium_platform.png" id="4_platform"]
