# Godot editor cache and generated import data.
.godot/

# Local export/build output.
/builds/*

# Large generated Pokemon sprite assets are bundled outside git for builds.
/assets/sprites/pokemon/

# Large music assets are bundled outside git for launcher builds.
/assets/music/*
!/assets/music/.gitkeep

# Launcher local editor cache and generated test archives.
/launcher/.godot/
/launcher/test_server/*.zip

# Android export/build output.
/android/

# OS/editor noise.
.DS_Store
Thumbs.db
.env
.env.*

.import/
*.import
__pycache__/
